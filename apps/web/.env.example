# Postgres — en docker-compose local apunta al servicio "postgres" del propio compose.
DATABASE_URL="postgresql://danme:danme@localhost:5432/danme?schema=public"

# Firma de la cookie de sesión del panel admin (SPEC-002). Generar con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambia-esto-por-un-valor-aleatorio-largo"

# Solo los usa `prisma db seed` para crear la primera cuenta admin.
ADMIN_EMAIL="cjhirashi@gmail.com"
ADMIN_PASSWORD="cambia-esta-password-temporal"
